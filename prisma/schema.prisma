

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  whatsapp  Int      
  ordenes   Orden[]  
}

model Producto {
  id         Int                  @id @default(autoincrement())
  nombre     String
  id_categoria Int
  categoria  Categoria            @relation(fields: [id_categoria], references: [id])
  lineas     Linea[] 
  
  ingredientes Producto_Ingrediente[] 
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String
  productos Producto[] 
}

model Orden {
  id             Int      @id @default(autoincrement())
  id_cliente     Int
  fecha_entrega  DateTime
  estado         Int   
  
  cliente        Cliente  @relation(fields: [id_cliente], references: [id])
  lineas         Linea[]
}

model Linea {
  id          Int      @id @default(autoincrement())
  id_producto Int
  cantidad    Int
  id_orden    Int
  
  orden       Orden    @relation(fields: [id_orden], references: [id])
  producto    Producto @relation(fields: [id_producto], references: [id])
}



model Proveedor {
  id       Int      @id @default(autoincrement())
  nombre   String
  compras  Compra[]
}

model Compra {
  id             Int             @id @default(autoincrement())
  id_proveedor   Int
  fecha_compra   DateTime @default(now())
  
  proveedor      Proveedor       @relation(fields: [id_proveedor], references: [id])
  detalles       Detalle_compra[]
}

model Detalle_compra {
  id                Int      @id @default(autoincrement())
  id_compra         Int
  id_ingredientes   Int
  cantidad          Float
  precio_unitario   Float
  subtotal          Float
  
  compra            Compra   @relation(fields: [id_compra], references: [id])
  ingrediente       Ingrediente @relation(fields: [id_ingredientes], references: [id])
  
  lotes             Lote[]   
}

model Ingrediente {
  id        Int             @id @default(autoincrement())
  nombre    String
  unidad_medida String
  detalles  Detalle_compra[] 
  
  productos  Producto_Ingrediente[] 
}

model Lote {
  id                Int      @id @default(autoincrement())
  id_detalle_compra Int
  cantidad_consumida Float   @default(0)
  
  detalle_compra    Detalle_compra @relation(fields: [id_detalle_compra], references: [id])
}

model Producto_Ingrediente {
  id             Int          @id @default(autoincrement())
  id_producto    Int
  id_ingrediente Int
  cantidad       Float       

  producto       Producto     @relation(fields: [id_producto], references: [id], onDelete: Cascade)
  ingrediente    Ingrediente  @relation(fields: [id_ingrediente], references: [id], onDelete: Cascade)

  @@unique([id_producto, id_ingrediente]) 
}